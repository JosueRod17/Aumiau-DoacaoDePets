# Copie para .env na raiz do projeto. Nunca envie .env ao Git.
# local: usa SQLite/media deste PC. shared: exige PostgreSQL e fotos remotas.
AUMIAU_DATA_MODE=local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Para shared, preencha os mesmos serviços em todos os PCs.
# Gere uma chave com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DOCUMENT_HASH_KEY=
# Login Google: credenciais de cliente OAuth do tipo Aplicativo da Web.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/usuarios/google/retorno/
# URL PostgreSQL fornecida pela hospedagem, com senha codificada para URL.
DATABASE_URL=

# Armazenamento compatível com S3. Use um bucket dedicado ao AuMiau.
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1
# Neon Object Storage: S3_REGION_NAME=AWS_REGION, S3_ENDPOINT_URL=AWS_ENDPOINT_URL_S3 e S3_ADDRESSING_STYLE=path.
# Cloudflare R2 (alternativa): S3_REGION_NAME=auto e S3_ADDRESSING_STYLE=path.
# Vazio para AWS S3; para outros provedores, use o endpoint HTTPS fornecido.
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=path

# Domínios HTTPS de acesso ao site, separados por vírgula (se hospedado).
DJANGO_CSRF_TRUSTED_ORIGINS=
